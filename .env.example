# Для локального Docker Compose значения по умолчанию уже подходят.
APP_PUBLIC_URL=http://localhost:3000
DEMO_PUBLIC_URL=http://localhost:3001
AVAILABILITY_TTL_MINUTES=30
YOOKASSA_MODE=test
YOOKASSA_ENABLE_LIVE=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
