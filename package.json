{
  "name": "gde-edim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "setup": "node scripts/manage.mjs setup",
    "import": "node scripts/manage.mjs import",
    "admin": "node scripts/manage.mjs admin",
    "demo": "node scripts/manage.mjs demo",
    "local": "node scripts/local.mjs",
    "import:osm": "node scripts/osm.mjs && node scripts/manage.mjs import",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node --env-file-if-exists=.env tests/browser.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.3",
    "@playwright/test": "1.56.1"
  }
}
